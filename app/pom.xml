<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <!-- El Core: publicado desde sm-core-maven. Esta version es la unica declaracion de la version del Core en el
         proyecto (de ahi salen core.version y la de cada core-*). Actualizarlo es cambiarla y seguir su changelog
         (ver docs/rules/versionado.md -> "Version del Core") -->
    <parent>
        <groupId>com.blue.open</groupId>
        <artifactId>core-parent</artifactId>
        <version>4.0.0</version>
        <relativePath/>
    </parent>

    <!-- Version propia del proyecto, independiente de la del Core (ver docs/rules/versionado.md). Es la unica
         fuente: Maven la escribe en app-version.properties y de ahi la leen /info y el header API-Version -->
    <groupId>com.sm</groupId>
    <artifactId>open-data-proyect</artifactId>
    <version>1.0.4</version>
    <name>open-data-proyect</name>
    <description>BackEnd de Open Data</description>

    <!-- Repositorio Maven publico del Core (GitHub Pages de sm-core-maven): de aca se descargan core-parent y los
         core-*, sin token. Maven lo usa tambien para resolver el <parent> -->
    <repositories>
        <repository>
            <id>sm-core</id>
            <name>Core de BlueOpenData (sm-core-maven)</name>
            <url>https://sm-soluciones.github.io/sm-core-maven</url>
            <releases>
                <enabled>true</enabled>
            </releases>
            <snapshots>
                <enabled>false</enabled>
            </snapshots>
        </repository>
    </repositories>

    <!-- Parches de seguridad sobre las versiones que fija Spring Boot 4.1.1 (via core-parent). OSV-Scanner reporto
         vulnerabilidades criticas y altas en Tomcat 11.0.24 y Jackson 2.21.5 / 3.1.5 (adenda de implementacion 1:
         ninguna alta ni critica). Se quitan cuando core-parent suba a un Boot que ya las traiga -->
    <properties>
        <tomcat.version>11.0.29</tomcat.version>
        <jackson-2-bom.version>2.21.8</jackson-2-bom.version>
        <jackson-bom.version>3.1.8</jackson-bom.version>
    </properties>

    <!-- Spring AI: servidor MCP (Streamable HTTP sin estado en /mcp, spec Spec 4). La version la fija su BOM -->
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.ai</groupId>
                <artifactId>spring-ai-bom</artifactId>
                <version>2.0.2</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-mcp-server-webmvc</artifactId>
        </dependency>
        <!--
          Modulos del Core que usa este proyecto.
          Para dejar de usar uno (ej. multiempresa o un protocolo de auth) se borra su dependencia
          y el include de su changelog en db.changelog-master.yaml.
          Ver docs/arquitectura/core/README.md
        -->
        <dependency>
            <groupId>com.blue.open</groupId>
            <artifactId>core-kernel</artifactId>
        </dependency>
        <dependency>
            <groupId>com.blue.open</groupId>
            <artifactId>core-crud</artifactId>
        </dependency>
        <dependency>
            <groupId>com.blue.open</groupId>
            <artifactId>core-identity</artifactId>
        </dependency>
        <dependency>
            <groupId>com.blue.open</groupId>
            <artifactId>core-monoempresa</artifactId>
        </dependency>
        <dependency>
            <groupId>com.blue.open</groupId>
            <artifactId>core-protocolo-jwt</artifactId>
        </dependency>
        <dependency>
            <groupId>com.blue.open</groupId>
            <artifactId>core-protocolo-apikey</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-devtools</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-restclient</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-aspectj</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <!-- Desde Spring Boot 4 la autoconfiguracion de Liquibase esta en su propio modulo: con solo
             liquibase-core el master no corre al arrancar -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-liquibase</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <!-- Base de datos -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Pruebas de contrato: PostgreSQL embebido, MockMvc, dobles y emisor del contrato (ver docs/arquitectura/testing) -->
        <dependency>
            <groupId>com.blue.open</groupId>
            <artifactId>core-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Reglas de arquitectura verificadas sobre el bytecode (ArquitecturaTest). Ver docs/auditoria/README.md -->
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit-junit5</artifactId>
            <version>1.4.1</version>
            <scope>test</scope>
        </dependency>

        <!--
          Mockito necesita un byte-buddy que soporte el bytecode de Java 25; solo se usa en tests.
          Librerias de propósito puntual (PDF, Office, Gemini, imagenes) no vienen en el template:
          cada proyecto agrega las que use.
        -->
        <dependency>
            <groupId>net.bytebuddy</groupId>
            <artifactId>byte-buddy</artifactId>
            <version>1.18.12</version>
        </dependency>
        <dependency>
            <groupId>net.bytebuddy</groupId>
            <artifactId>byte-buddy-agent</artifactId>
            <version>1.18.12</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <resources>
            <!-- app-version.properties se filtra para tomar <version> de este pom; el resto no, porque las
                 application.*.properties usan ${...} de Spring que Maven no debe reemplazar -->
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
                <includes>
                    <include>app-version.properties</include>
                </includes>
            </resource>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>false</filtering>
                <excludes>
                    <exclude>app-version.properties</exclude>
                </excludes>
            </resource>
            <!-- Plantillas HTML de las notificaciones: viven junto a su clase en Code/{Entidad}/Notifications/ -->
            <resource>
                <directory>src/main/java</directory>
                <includes>
                    <include>**/*.html</include>
                </includes>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <executable>true</executable>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
            </plugin>
            <!-- Contrato de endpoint dentro del jar (classpath:/docs-api/, servido en /api/docs si contratos.publicar=true):
                 la copia commiteada (docs/api), que solo se reescribe en una corrida completa de tests en verde. Una
                 corrida parcial o fallida nunca llega al jar. Sin docs/api en el contexto de build no se empaqueta -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
                <executions>
                    <execution>
                        <id>contrato-commiteado</id>
                        <phase>prepare-package</phase>
                        <goals>
                            <goal>copy-resources</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${project.build.outputDirectory}/docs-api</outputDirectory>
                            <resources>
                                <resource>
                                    <directory>${project.basedir}/../docs/api</directory>
                                    <includes>
                                        <include>openapi.yaml</include>
                                        <include>index.html</include>
                                    </includes>
                                </resource>
                            </resources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <!-- Pruebas de contrato (core-test): donde se escribe el contrato, a donde se copia en una corrida completa
                 en verde y con que version se publica. Ver docs/arquitectura/testing/README.md -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <!-- @{argLine} suma el agente de JaCoCo a las opciones add-opens que fija core-parent -->
                    <argLine>
                        @{argLine}
                        --add-opens java.base/java.lang=ALL-UNNAMED
                        --add-opens java.base/java.util=ALL-UNNAMED
                    </argLine>
                    <systemPropertyVariables>
                        <contratos.directorio>${project.build.directory}/contratos</contratos.directorio>
                        <contratos.destino>${project.basedir}/../docs/api</contratos.destino>
                        <contratos.version>${project.version}</contratos.version>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
            </plugin>
            <!-- Criterios de calidad del plan (adenda de implementacion 1): cobertura de lineas del backend de 80% o mas,
                 medida sobre la suite completa (unitarias y pruebas de contrato). verify falla si no se cumple.
                 Application y las clases de configuracion de arranque no cuentan -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>0.8.16</version>
                <executions>
                    <execution>
                        <id>agente</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>reporte</id>
                        <phase>test</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>umbral</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                        <configuration>
                            <excludes>
                                <exclude>com/blue/open/Application.class</exclude>
                            </excludes>
                            <rules>
                                <rule>
                                    <element>BUNDLE</element>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.80</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <!-- Codigo duplicado (PMD CPD, adenda de implementacion 1): ningun bloque de mas de 50 tokens repetido en el
                 codigo de main, ignorando anotaciones (@Contrato y @Descripcion se repiten por regla). verify falla -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-pmd-plugin</artifactId>
                <version>3.28.0</version>
                <configuration>
                    <minimumTokens>50</minimumTokens>
                    <ignoreAnnotations>true</ignoreAnnotations>
                    <includeTests>false</includeTests>
                    <printFailingErrors>true</printFailingErrors>
                </configuration>
                <executions>
                    <execution>
                        <id>duplicados</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>cpd-check</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
