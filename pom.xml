<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
      Agregador del repositorio: permite correr mvn desde la raiz (mvn -pl app test, mvn package en el Dockerfile).
      No es el parent de app ni define versiones: app hereda de com.blue.open:core-parent, publicado desde
      sm-core-maven (ver docs/arquitectura/core/README.md -> "Distribucion").
    -->
    <groupId>com.blue.open</groupId>
    <artifactId>open-data-proyect-reactor</artifactId>
    <version>1.0.0</version>
    <packaging>pom</packaging>
    <name>open-data-proyect-reactor</name>

    <modules>
        <module>app</module>
    </modules>
</project>
